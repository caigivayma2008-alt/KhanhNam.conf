#!name=Locket Gold & YouTube Premium
#!desc=Locket (Tự host) + YouTube (Auto Update từ Akira)
#!author=Hoang Khanh Nam

[Rule]
# --- YOUTUBE CHẶN QUẢNG CÁO ---
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# --- YOUTUBE REWRITE ---
(^https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?://[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?://(?:www|s)\.youtube\.com/api/stats/ads _ reject-200
^https?://(?:www|s)\.youtube\.com/(?:pagead|ptracking) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext _ reject-200

[Script]
# --- LOCKET GOLD (TỰ HOST - BẤT TỬ) ---
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/caigivayma2008-alt/KhanhNam.conf/main/locket.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/caigivayma2008-alt/KhanhNam.conf/main/header.js, timeout=60

# --- YOUTUBE PREMIUM (LINK GỐC AKIRA) ---
youtube_response=type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:[/?#]|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/main/scripts/youtube-response.js,argument="{}"

[MITM]
# --- BẮT BUỘC VIẾT LIỀN KHÔNG KHOẢNG TRẮNG ---
hostname = %APPEND% api.revenuecat.com,-redirector*.googlevideo.com,*.googlevideo.com,s.youtube.com,www.youtube.com,youtubei.googleapis.com
